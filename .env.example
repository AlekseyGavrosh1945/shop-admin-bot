# Токен бота от @BotFather (обязателен)
BOT_TOKEN=

# Белый список Telegram chat ID через запятую.
# Свой ID можно узнать командой /id у работающего бота.
ADMIN_CHAT_IDS=

# DSN MySQL магазина. Только чтение: бот делает SELECT-запросы.
# Локальная копия stage-базы (см. README, раздел «Разработка»):
DATABASE_URL=root:devroot@tcp(127.0.0.1:3307)/toflow?parseTime=true

# Адрес HTTP-сервера с /healthz
HTTP_ADDR=:8081

# Как часто проверять события для пушей (новые заказы, чаты, тикеты...)
POLL_INTERVAL=30s

# Файл состояния пушей (курсоры по источникам)
STATE_FILE=bot_state.json
